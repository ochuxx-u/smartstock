        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Usuario {\n        +UUID id\n        +string nombre\n        +string email\n        +string hashContrasena\n        +Rol rol\n        +bool activo\n        +datetime ultimoAcceso\n        +iniciarSesion()\n        +cerrarSesion()\n    }\n\n    class Rol {\n        &lt;&lt;enumeration&gt;&gt;\n        Administrador\n        Empleado\n        Propietario\n    }\n\n    class Producto {\n        +UUID id\n        +string nombre\n        +int stockMinimo\n        +int puntoReorden\n        +int calcularStockActual()\n        +bool estaBajoMinimo()\n    }\n\n    class Lote {\n        +UUID id\n        +UUID productoId\n        +string numeroLote\n        +int cantidadInicial\n        +int cantidadDisponible\n        +date fechaVencimiento\n        +EstadoLote estado\n        +int diasRestantes()\n        +bool estaVencido()\n        +bool estaPorVencer(int dias)\n        +void descontar(int cantidad)\n    }\n\n    class EstadoLote {\n        &lt;&lt;enumeration&gt;&gt;\n        Vigente\n        PorVencer\n        Vencido\n        Agotado\n    }\n\n    class Movimiento {\n        +UUID id\n        +UUID loteId\n        +UUID usuarioId\n        +TipoMovimiento tipo\n        +int cantidad\n        +decimal costoUnitario\n        +string motivo\n        +UUID usuarioId\n        +datetime fechaHora\n        +bool anulado\n        +UUID movimientoOriginalId\n    }\n\n    class TipoMovimiento {\n        &lt;&lt;enumeration&gt;&gt;\n        Entrada\n        Salida\n        Ajuste\n        Anulacion\n    }\n\n    class Alerta {\n        +UUID id\n        +UUID loteId\n        +TipoAlerta tipo\n        +EstadoAlerta estado\n        +int stockActual\n        +int umbral\n        +datetime fechaGeneracion\n        +datetime fechaAtencion\n        +string comentario\n    }\n\n    class TipoAlerta {\n        &lt;&lt;enumeration&gt;&gt;\n        BajoStock\n        ProximoVencimiento\n        Vencido\n        QuiebreStock\n    }\n\n    class EstadoAlerta {\n        &lt;&lt;enumeration&gt;&gt;\n        Nueva\n        Atendida\n        Pospuesta\n        Descartada\n    }\n\n    class Proveedor {\n        +UUID id\n        +string nombre\n        +string contacto\n        +string telefono\n        +string email\n    }\n\n    class OrdenCompra {\n        +UUID id\n        +UUID proveedorId\n        +OrigenOrden origen\n        +EstadoOrden estado\n        +date fechaEsperada\n        +datetime fechaCreacion\n    }\n\n    class OrigenOrden {\n        &lt;&lt;enumeration&gt;&gt;\n        AlertaSistema\n        RevisionVisual\n    }\n\n    class EstadoOrden {\n        &lt;&lt;enumeration&gt;&gt;\n        Pendiente\n        Atendida\n        Cancelada\n    }\n\n    class Configuracion {\n        +int diasAnticipacionVencimiento\n        +int horasAntiduplicado\n        +string correosDestino\n    }\n\n    Usuario \&quot;1\&quot; --&gt; \&quot;*\&quot; Movimiento : registra\n    Usuario --&gt; Rol\n    Producto \&quot;1\&quot; --&gt; \&quot;*\&quot; Lote : está\n    Lote \&quot;1\&quot; --&gt; \&quot;*\&quot; Movimiento : afecta\n    Lote --&gt; EstadoLote\n    Lote \&quot;1\&quot; --&gt; \&quot;*\&quot; Alerta : genera\n    Producto \&quot;*\&quot; --&gt; \&quot;*\&quot; Proveedor : suministrado por\n    Movimiento --&gt; TipoMovimiento\n    Movimiento \&quot;0..1\&quot; --&gt; \&quot;1\&quot; Movimiento : anula a\n    Alerta --&gt; TipoAlerta\n    Alerta --&gt; EstadoAlerta\n    OrdenCompra \&quot;*\&quot; --&gt; \&quot;1\&quot; Proveedor\n    OrdenCompra --&gt; OrigenOrden\n    OrdenCompra --&gt; EstadoOrden\n    OrdenCompra \&quot;1\&quot; --&gt; \&quot;*\&quot; Movimiento : genera entradas&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KxjMV8ykp5oQEzpy_erT-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
