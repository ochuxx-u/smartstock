  <diagram id="0wh982GiF6LNlMFiW6hh" name="Secuencia_Registro_Users">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor ADM as Administrador\n    actor EMP as Empleado\n    participant UI as NiceGUI (Frontend)\n    participant API as Google Apps Script\n    participant DB as Google Sheets (Usuarios)\n\n    Note over ADM,DB: Alta / edición de usuario\n    ADM-&gt;&gt;UI: Abre módulo Usuarios\n    UI-&gt;&gt;API: GET /usuarios (rol=Admin)\n    API-&gt;&gt;DB: Verifica rol del solicitante\n    DB--&gt;&gt;API: rol=Administrador ✓\n    API--&gt;&gt;UI: Lista de usuarios\n    ADM-&gt;&gt;UI: Crea usuario (nombre, email, rol)\n    UI-&gt;&gt;API: POST /usuarios\n    API-&gt;&gt;API: Valida rol (solo Admin)\n    API-&gt;&gt;DB: INSERT usuario (activo=true, hash pwd)\n    DB--&gt;&gt;API: idUsuario\n    API--&gt;&gt;UI: 201 Created\n    UI--&gt;&gt;ADM: Confirmación\n\n    Note over EMP,DB: Inicio de sesión\n    EMP-&gt;&gt;UI: Ingresa usuario y contraseña\n    UI-&gt;&gt;API: POST /auth/login\n    API-&gt;&gt;DB: Consulta hash y estado del usuario\n    DB--&gt;&gt;API: hash, activo\n    alt Usuario válido y activo\n        API-&gt;&gt;DB: Registra sesión (usuario, fecha, hora)\n        API--&gt;&gt;UI: 200 OK {token/rol}\n        UI--&gt;&gt;EMP: Accede al dashboard según rol\n    else Usuario inválido o inactivo\n        API--&gt;&gt;UI: 401 Error\n        UI--&gt;&gt;EMP: Mensaje de error\n    end\n\n    Note over EMP,DB: Verificación de permisos por operación\n    EMP-&gt;&gt;UI: Intenta anular movimiento\n    UI-&gt;&gt;API: DELETE /movimientos/{id}\n    API-&gt;&gt;DB: Consulta rol del usuario\n    DB--&gt;&gt;API: rol=Empleado\n    API--&gt;&gt;UI: 403 Forbidden (RNF-012)\n    UI--&gt;&gt;EMP: \&quot;Solo el administrador puede anular\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4J4wpzdUvkjT2YcDoeLN-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Administrador" mermaidId="n:ADM" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Administrador" id="4J4wpzdUvkjT2YcDoeLN-2">
