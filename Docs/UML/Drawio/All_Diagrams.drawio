        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USUARIO ||--o{ MOVIMIENTO : registra\n    USUARIO ||--o{ AUDITORIA : genera\n    PRODUCTO ||--o{ LOTE : contiene\n    PRODUCTO ||--o{ MOVIMIENTO : afecta\n    PRODUCTO ||--o{ ALERTA : origina\n    PRODUCTO }o--o{ PROVEEDOR : suministrado\n    PROVEEDOR ||--o{ ORDEN_COMPRA : recibe\n    ORDEN_COMPRA ||--o{ MOVIMIENTO : genera\n\n    USUARIO {\n        uuid id PK\n        string nombre\n        string email\n        string hash_contrasena\n        string rol\n        boolean activo\n        datetime ultimo_acceso\n    }\n\n    PRODUCTO {\n        uuid id PK\n        string nombre\n        string categoria\n        string unidad_medida\n        decimal costo\n        int stock_minimo\n        int punto_reorden\n        boolean activo\n    }\n\n    LOTE {\n        uuid id PK\n        uuid producto_id FK\n        string numero_lote\n        int cantidad\n        date fecha_vencimiento\n    }\n\n    MOVIMIENTO {\n        uuid id PK\n        uuid producto_id FK\n        uuid usuario_id FK\n        uuid orden_compra_id FK\n        string tipo\n        int cantidad\n        decimal costo_unitario\n        string motivo\n        datetime fecha_hora\n        boolean anulado\n        uuid movimiento_original_id FK\n    }\n\n    ALERTA {\n        uuid id PK\n        uuid producto_id FK\n        string tipo\n        string estado\n        int stock_actual\n        int umbral\n        datetime fecha_generacion\n        datetime fecha_atencion\n        string comentario\n    }\n\n    PROVEEDOR {\n        uuid id PK\n        string nombre\n        string contacto\n        string telefono\n        string email\n    }\n\n    ORDEN_COMPRA {\n        uuid id PK\n        uuid proveedor_id FK\n        string origen\n        string estado\n        date fecha_esperada\n        datetime fecha_creacion\n    }\n\n    CONFIGURACION {\n        int id PK\n        int dias_anticipacion_vencimiento\n        int horas_antiduplicado\n        string correos_destino\n    }\n\n    AUDITORIA {\n        uuid id PK\n        uuid usuario_id FK\n        string entidad\n        string operacion\n        json valor_anterior\n        json valor_nuevo\n        datetime fecha\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zqWGkkunMkbcDW2dvYto-1">
