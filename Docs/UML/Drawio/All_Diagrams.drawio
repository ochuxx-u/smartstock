  <diagram id="fAqrCR9V3zcyKLcGxdp3" name="Secuencia_Salida">
    <mxGraphModel dx="1664" dy="993" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    participant EMP as Empleado\n    participant UI as NiceGUI\n    participant API as Apps Script\n    participant DB as Google Sheets\n\n    EMP-&gt;&gt;UI: Registra salida (producto=Leche, cantidad=6)\n    UI-&gt;&gt;API: POST /movimientos/salida\n    API-&gt;&gt;DB: Consulta lotes vigentes del producto (FEFO)\n    DB--&gt;&gt;API: Lote L-2026-09-20 (vence 20/10, disp 6), Lote L-2026-10-05 (vence 05/11, disp 12)\n    API-&gt;&gt;API: Selecciona L-2026-09-20 (más próximo a vencer)\n    API--&gt;&gt;UI: Sugerencia: consumir L-2026-09-20\n    UI-&gt;&gt;EMP: Muestra sugerencia FEFO\n    EMP-&gt;&gt;UI: Confirma\n    UI-&gt;&gt;API: POST /movimientos/salida {lote_id: L-2026-09-20, cantidad: 6}\n    API-&gt;&gt;DB: INSERT MOVIMIENTO (lote_id, producto_id, ...)\n    API-&gt;&gt;DB: UPDATE LOTE.cantidad_disponible -= 6\n    API-&gt;&gt;DB: UPDATE LOTE.estado = Agotado (si quedó en 0)\n    API--&gt;&gt;UI: 200 OK&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="25ngUOVJO4P0GJtRKLRo-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
